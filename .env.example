# --- SIP leg: credentials you created in the Fritz!Box UI -------------------
# Telephony > Telephony Devices > Configure New Device > Telephone > LAN/Wi-Fi (IP phone)
# Both values must be >= 8 characters, and the password must differ substantially
# from the username, or the Fritz!Box refuses to save them.
PHONELLM_SIP_USER=phonellm01
PHONELLM_SIP_PASS=change-this-please

PHONELLM_SIP_REGISTRAR=fritz.box
# Leave BIND_HOST empty to auto-detect the LAN address used to reach the registrar.
# Set it explicitly on a multi-homed host.
PHONELLM_BIND_HOST=
PHONELLM_BIND_PORT=5060
PHONELLM_RTP_PORT_MIN=16384
PHONELLM_RTP_PORT_MAX=16484

# --- OpenAI Realtime leg ---------------------------------------------------
OPENAI_API_KEY=sk-...
PHONELLM_MODEL=gpt-realtime
PHONELLM_VOICE=alloy
# PHONELLM_INSTRUCTIONS_FILE=/etc/phonellm/instructions.txt

# --- Call behaviour --------------------------------------------------------
PHONELLM_RING_DELAY=2s
PHONELLM_MAX_CALL_TIME=5m
PHONELLM_SILENCE_TIMEOUT=30s

# Milestone 0 gate: echo the caller back to themselves, no LLM, no API key needed.
# Run with this set to true FIRST. If you do not hear yourself, nothing else matters.
PHONELLM_ECHO_TEST=false

# --- Artefacts (optional) --------------------------------------------------
PHONELLM_RECORD_DIR=/var/lib/phonellm/recordings
PHONELLM_TRANSCRIPT_DIR=/var/lib/phonellm/transcripts

# --- Notification (all optional) -------------------------------------------
PHONELLM_SUMMARY_MODEL=gpt-4.1-mini
# PHONELLM_TELEGRAM_TOKEN=
# PHONELLM_TELEGRAM_CHAT_ID=
# PHONELLM_SMTP_HOST=
# PHONELLM_SMTP_PORT=587
# PHONELLM_SMTP_USER=
# PHONELLM_SMTP_PASS=
# PHONELLM_SMTP_FROM=
# PHONELLM_SMTP_TO=

# PHONELLM_LOG_LEVEL=info
