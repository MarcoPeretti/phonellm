[Unit]
Description=phonellm - LLM answering machine on a Fritz!Box line
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phonellm
Group=phonellm
ExecStart=/usr/local/bin/phonellm
# StateDirectory below creates /var/lib/phonellm with the right ownership. These come
# before EnvironmentFile so the env file can still override them: systemd applies both
# in the order they appear.
Environment=PHONELLM_RECORD_DIR=/var/lib/phonellm/recordings
Environment=PHONELLM_TRANSCRIPT_DIR=/var/lib/phonellm/transcripts
EnvironmentFile=/etc/phonellm/phonellm.env
Restart=always
RestartSec=5s

StateDirectory=phonellm
WorkingDirectory=/var/lib/phonellm

# The process needs no privileges: SIP 5060 and the RTP range are unprivileged ports.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/phonellm

[Install]
WantedBy=multi-user.target
